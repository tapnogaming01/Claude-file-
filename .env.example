API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# Your bot's @username WITHOUT the @ (needed to build deep links like
# https://t.me/YourBot?start=batch-slug-1-10)
BOT_USERNAME=YourBotUsername

# MongoDB Atlas connection string (or your own self-hosted MongoDB URI)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGO_DB_NAME=episode_bot

# Comma-separated Telegram user IDs who can use /addsource, /removesource, /listsources, /addlogchannel
ADMIN_IDS=123456789,987654321

# How many episodes are grouped into one batch button, e.g. "211-220"
BATCH_SIZE=10
# How many new files trigger posting a new batch block in the target channel
FILES_PER_BLOCK=5

# Render sets this automatically, you don't need to set it yourself
PORT=8080

SESSION_NAME=episode_bot
